{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/consumables",
      "destination": "/products#consumables",
      "permanent": true
    },
    {
      "source": "/consumables.html",
      "destination": "/products#consumables",
      "permanent": true
    },
    {
      "source": "/specifications",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/specifications.html",
      "destination": "/products",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
